NODE_ENV=development
PORT=3000

# Comma-separated browser origins allowed to call this API (CORS). When unset, defaults to http://localhost:3000 and http://127.0.0.1:3000 for local Next.js.
# CORS_ORIGIN=https://app.example.com

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/wholesale?schema=public

JWT_SECRET=change-me-to-a-long-random-string-in-production
JWT_EXPIRES_IN=7d

# HttpOnly browser session cookie for the access JWT.
AUTH_COOKIE_NAME=access_token
AUTH_COOKIE_MAX_AGE_SECONDS=604800
# Defaults to false in development, true in production.
# SameSite defaults to lax for non-secure local cookies and none for secure production cookies.
# Direct cross-site web -> API auth requires AUTH_COOKIE_SECURE=true and AUTH_COOKIE_SAMESITE=none over HTTPS.
# Same-origin/proxied local dev can keep AUTH_COOKIE_SECURE=false and SameSite=lax.
# Local/proxied example:
# AUTH_COOKIE_SECURE=false
# AUTH_COOKIE_SAMESITE=lax
# Cross-site HTTPS deployment example:
# AUTH_COOKIE_SECURE=true
# AUTH_COOKIE_SAMESITE=none
# AUTH_COOKIE_DOMAIN=

# Google Sign-In — must match the web app NEXT_PUBLIC_GOOGLE_CLIENT_ID (OAuth 2.0 Web client ID).
# ID-token verification does not use client_secret; keep secrets out of source control regardless.
# If a client_secret was ever leaked, rotate it in Google Cloud Console → Credentials.
GOOGLE_CLIENT_ID=

MOQ_MIN_AMOUNT_INR=2000
STANDARD_DELIVERY_FEE_INR=0
PRIORITY_DELIVERY_MULTIPLIER=0.05
MIN_PRIORITY_DELIVERY_FEE_INR=99

# Razorpay UPI checkout. When key id/secret are empty, local development uses
# a demo checkout order that can be verified without charging money.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
PARTIAL_PAYMENT_THRESHOLD_INR=5000
PARTIAL_PAYMENT_PERCENT=20
ALLOW_CASH_DUE_COLLECTION=true

OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_PEPPER=
# In development, if set to "true", OTP codes are logged and a fixed dev OTP "000000" is accepted when no DB challenge exists (do not use in production).
OTP_DEV_MODE=true

# POST /api/auth/google/send-otp — max requests per IP per window (in-memory; use Redis throttler storage for multiple app instances).
AUTH_GOOGLE_SEND_OTP_LIMIT=5
AUTH_GOOGLE_SEND_OTP_TTL_SECONDS=3600

DEFAULT_WAREHOUSE_ID=default

# Supabase Storage for product images. Keep SUPABASE_SECRET_KEY on the backend only.
SUPABASE_URL=https://stdabaxmvaaooiuzpmle.supabase.co
SUPABASE_SECRET_KEY=
SUPABASE_STORAGE_BUCKET=Images

# Delivery/rider app
RIDER_LOCATION_UPDATE_INTERVAL_SECONDS=15
DELIVERY_PICKUP_LABEL=Main warehouse
DELIVERY_PICKUP_LAT=
DELIVERY_PICKUP_LNG=

# Native Android FCM push.
FCM_PUSH_ENABLED=true
FIREBASE_PROJECT_ID=
# Set to the full Firebase service account JSON string in production, or rely
# on Google application default credentials in managed Google environments.
FIREBASE_SERVICE_ACCOUNT_JSON=

# Optional legacy Expo push support. Native Android rider builds use FCM.
EXPO_PUSH_ENABLED=false
# EXPO_ACCESS_TOKEN=
