generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url = env("DATABASE_URL")
}

enum UserRole {
  BUYER
  ADMIN
  RIDER
}

enum ProductUnit {
  PIECE
  PACK
}

enum DeliveryType {
  STANDARD
  PRIORITY
}

enum OrderStatus {
  PLACED
  CONFIRMED
  PACKED
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
}

enum RiderStatus {
  IDLE
  BUSY
}

enum BusinessType {
  RESTAURANT
  EVENT_PLANNER
  OTHER
}

enum PricingDiscountType {
  PERCENT_OFF
  AMOUNT_OFF
}

enum PricingRuleAuditAction {
  CREATED
  UPDATED
  DISABLED
  ENABLED
}

model User {
  id                    String                    @id @default(cuid())
  phone                 String                    @unique
  passwordHash          String?
  email                 String?                   @unique
  name                  String?
  googleId              String?                   @unique
  businessName          String
  businessType          BusinessType              @default(OTHER)
  gstNumber             String?
  isOnboardingCompleted Boolean                   @default(false)
  role                  UserRole                  @default(BUYER)
  addresses             Address[]
  orders                Order[]
  pricingRules          UserProductPricingRule[]  @relation("BuyerPricingRules")
  pricingRulesCreated   UserProductPricingRule[]  @relation("PricingRulesCreatedBy")
  pricingRulesUpdated   UserProductPricingRule[]  @relation("PricingRulesUpdatedBy")
  pricingAuditsChanged  UserProductPricingAudit[] @relation("PricingAuditsChangedBy")
  createdAt             DateTime                  @default(now())
  updatedAt             DateTime                  @updatedAt
}

model Address {
  id        String  @id @default(cuid())
  userId    String
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  line1     String
  line2     String?
  city      String
  state     String
  pincode   String
  isDefault Boolean @default(false)

  @@index([userId])
}

model Product {
  id               String       @id @default(cuid())
  name             String
  category         String
  unit             ProductUnit
  basePrice        Decimal      @db.Decimal(12, 2)
  imageUrls        Json         @default("[]")
  bulkPricingTiers Json
  inventory        Inventory?
  orderItems       OrderItem[]
  pricingRules     UserProductPricingRule[]
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  @@index([category])
}

model Inventory {
  id            String  @id @default(cuid())
  productId     String  @unique
  product       Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  warehouseId   String  @default("default")
  availableQty  Int
  reservedQty   Int     @default(0)
  version       Int     @default(0)

  @@index([warehouseId])
}

model Order {
  id              String        @id @default(cuid())
  userId          String
  user            User          @relation(fields: [userId], references: [id])
  items           OrderItem[]
  status          OrderStatus   @default(PLACED)
  deliveryType    DeliveryType
  deliveryFee     Decimal       @db.Decimal(12, 2)
  subtotalAmount  Decimal       @db.Decimal(12, 2)
  totalAmount     Decimal       @db.Decimal(12, 2)
  addressSnapshot Json
  riderId         String?
  rider           Rider?        @relation(fields: [riderId], references: [id])
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([userId])
  @@index([status])
  @@index([deliveryType])
}

model OrderItem {
  id              String  @id @default(cuid())
  orderId         String
  order           Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId       String
  product         Product @relation(fields: [productId], references: [id])
  quantity        Int
  priceApplied    Decimal @db.Decimal(12, 2)
  pricingSnapshot Json?

  @@index([orderId])
  @@index([productId])
}

model UserProductPricingRule {
  id               String                    @id @default(cuid())
  userId           String
  user             User                      @relation("BuyerPricingRules", fields: [userId], references: [id], onDelete: Cascade)
  productId        String
  product          Product                   @relation(fields: [productId], references: [id], onDelete: Cascade)
  discountType     PricingDiscountType
  discountValue    Decimal                   @db.Decimal(12, 2)
  isActive         Boolean                   @default(true)
  adminNote        String?
  createdByAdminId String?
  createdByAdmin   User?                     @relation("PricingRulesCreatedBy", fields: [createdByAdminId], references: [id], onDelete: SetNull)
  updatedByAdminId String?
  updatedByAdmin   User?                     @relation("PricingRulesUpdatedBy", fields: [updatedByAdminId], references: [id], onDelete: SetNull)
  audits           UserProductPricingAudit[]
  createdAt        DateTime                  @default(now())
  updatedAt        DateTime                  @updatedAt

  @@unique([userId, productId])
  @@index([productId])
  @@index([isActive])
  @@index([createdByAdminId])
  @@index([updatedByAdminId])
}

model UserProductPricingAudit {
  id               String                 @id @default(cuid())
  ruleId           String
  rule             UserProductPricingRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  userId           String
  productId        String
  changedByAdminId String?
  changedByAdmin   User?                  @relation("PricingAuditsChangedBy", fields: [changedByAdminId], references: [id], onDelete: SetNull)
  action           PricingRuleAuditAction
  oldValue         Json?
  newValue         Json?
  reason           String
  createdAt        DateTime               @default(now())

  @@index([ruleId])
  @@index([userId])
  @@index([productId])
  @@index([changedByAdminId])
  @@index([createdAt])
}

model Rider {
  id              String      @id @default(cuid())
  name            String
  phone           String      @unique
  status          RiderStatus @default(IDLE)
  currentLocation Json?
  orders          Order[]
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
}

model OtpChallenge {
  id         String    @id @default(cuid())
  phone      String
  codeHash   String
  expiresAt  DateTime
  attempts   Int       @default(0)
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([phone, expiresAt])
}
