generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  BUYER
  ADMIN
  RIDER
}

enum ProductUnit {
  PIECE
  PACK
}

enum DeliveryType {
  STANDARD
  PRIORITY
}

enum OrderStatus {
  PLACED
  RIDER_ASSIGNED
  PICKED_UP
  CONFIRMED
  PACKED
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
}

enum RiderStatus {
  IDLE
  BUSY
}

enum PaymentMode {
  UPI
  PARTIAL_UPI
  LEGACY
}

enum PaymentStatus {
  PENDING
  PAID
  PARTIALLY_PAID
  FAILED
}

enum CollectionStatus {
  NOT_REQUIRED
  PENDING
  COLLECTED
  WAIVED
}

enum CollectionMethod {
  CASH
  UPI_AT_DELIVERY
}

enum BusinessType {
  FOOD_AND_BEVERAGE
  HEALTHCARE_AND_MEDICAL
  HOSPITALITY_AND_SERVICES
  RETAIL_AND_ECOMMERCE
  OTHER
}

enum PricingDiscountType {
  PERCENT_OFF
  AMOUNT_OFF
}

enum PricingRuleAuditAction {
  CREATED
  UPDATED
  DISABLED
  ENABLED
}

enum ProductCategory {
  TISSUE_AND_HYGIENE
  PARTY_AND_CELEBRATION
  CLEANING_AND_FRAGRANCE
  FOOD_ITEMS_AND_CONDIMENTS
  TABLEWARE
  PACKAGING_AND_CARRY_BAGS
}

model User {
  id                    String                    @id @default(cuid())
  phone                 String                    @unique
  passwordHash          String?
  email                 String?                   @unique
  name                  String?
  googleId              String?                   @unique
  businessName          String
  businessType          BusinessType              @default(OTHER)
  gstNumber             String?
  isOnboardingCompleted Boolean                   @default(false)
  role                  UserRole                  @default(BUYER)
  addresses             Address[]
  orders                Order[]
  pricingRules          UserProductPricingRule[]  @relation("BuyerPricingRules")
  pricingRulesCreated   UserProductPricingRule[]  @relation("PricingRulesCreatedBy")
  pricingRulesUpdated   UserProductPricingRule[]  @relation("PricingRulesUpdatedBy")
  pricingAuditsChanged  UserProductPricingAudit[] @relation("PricingAuditsChangedBy")
  rider                 Rider?
  createdAt             DateTime                  @default(now())
  updatedAt             DateTime                  @updatedAt
}

model Address {
  id                     String  @id @default(cuid())
  userId                 String
  user                   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  line1                  String
  line2                  String?
  city                   String
  state                  String
  pincode                String
  latitude               Float?
  longitude              Float?
  locationAccuracyMeters Float?
  locationSource         String?
  isDefault              Boolean @default(false)

  @@index([userId])
}

/// Catalog product. Pricing and stock live entirely on `InventoryBatch` —
/// this model carries only describe-the-product fields.
model Product {
  id            String                   @id @default(cuid())
  name          String
  category      ProductCategory
  unit          ProductUnit
  piecesPerPack Int?
  isPublic      Boolean                  @default(false)
  imageUrls     Json                     @default("[]")
  batches       InventoryBatch[]
  orderItems    OrderItem[]
  pricingRules  UserProductPricingRule[]
  createdAt     DateTime                 @default(now())
  updatedAt     DateTime                 @updatedAt

  @@index([category])
}

/// An independent purchasable unit of inventory for a product. New stock is added
/// as a new batch with its own `costPrice`, `sellingPrice`, and `bulkTiers`.
/// Lower `batchNumber` batches are consumed first (FIFO).
/// `bulkTiers` is a JSON array of `{ minimumQuantity, pricePerUnit }`:
///   - At least 1, at most 3 tiers.
///   - `minimumQuantity` must not exceed the batch's `quantity`.
model InventoryBatch {
  id           String                     @id @default(cuid())
  productId    String
  product      Product                    @relation(fields: [productId], references: [id], onDelete: Cascade)
  batchNumber  Int
  costPrice    Decimal                    @db.Decimal(12, 2)
  sellingPrice Decimal                    @db.Decimal(12, 2)
  quantity     Int
  bulkTiers    Json
  /// Optimistic-lock token. Every reserve / restore / admin update increments
  /// this. Concurrent writers that snapshotted a stale row will fail their
  /// predicate match and the order is retried inside the serializable tx.
  version      Int                        @default(0)
  allocations  OrderItemBatchAllocation[]
  createdAt    DateTime                   @default(now())
  updatedAt    DateTime                   @updatedAt

  @@unique([productId, batchNumber])
  @@index([productId, batchNumber])
}

/// Records the FIFO allocation of an order item across one or more inventory batches.
/// Allows the order summary to reconstruct the split pricing breakdown.
model OrderItemBatchAllocation {
  id          String         @id @default(cuid())
  orderItemId String
  orderItem   OrderItem      @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  batchId     String
  batch       InventoryBatch @relation(fields: [batchId], references: [id])
  quantity    Int
  unitPrice   Decimal        @db.Decimal(12, 2)
  createdAt   DateTime       @default(now())

  @@index([orderItemId])
  @@index([batchId])
}

model Order {
  id                        String                   @id @default(cuid())
  userId                    String
  user                      User                     @relation(fields: [userId], references: [id])
  items                     OrderItem[]
  status                    OrderStatus              @default(PLACED)
  deliveryType              DeliveryType
  deliveryFee               Decimal                  @db.Decimal(12, 2)
  subtotalAmount            Decimal                  @db.Decimal(12, 2)
  totalAmount               Decimal                  @db.Decimal(12, 2)
  addressSnapshot           Json
  paymentMode               PaymentMode              @default(UPI)
  paymentStatus             PaymentStatus            @default(PENDING)
  paidAmount                Decimal                  @default(0) @db.Decimal(12, 2)
  dueAmount                 Decimal                  @default(0) @db.Decimal(12, 2)
  paymentCollectionRequired Boolean                  @default(false)
  collectionStatus          CollectionStatus         @default(NOT_REQUIRED)
  collectionMethod          CollectionMethod?
  collectionInstructions    String?
  paymentTransactions       PaymentTransaction[]
  paymentAudits             PaymentAudit[]
  collectionEvents          RiderPaymentCollection[]
  riderId                   String?
  rider                     Rider?                   @relation(fields: [riderId], references: [id])
  pickedUpAt                DateTime?
  deliveredAt               DateTime?
  deliveryDistanceKm        Decimal?                 @db.Decimal(8, 2)
  createdAt                 DateTime                 @default(now())
  updatedAt                 DateTime                 @updatedAt

  @@index([userId])
  @@index([status])
  @@index([paymentStatus])
  @@index([paymentCollectionRequired, collectionStatus])
  @@index([deliveryType])
  @@index([riderId])
  @@index([riderId, status])
  @@index([riderId, status, updatedAt])
}

model PaymentTransaction {
  id                String        @id @default(cuid())
  orderId           String
  order             Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  provider          String        @default("razorpay")
  razorpayOrderId   String?       @unique
  razorpayPaymentId String?       @unique
  amount            Decimal       @db.Decimal(12, 2)
  currency          String        @default("INR")
  status            PaymentStatus @default(PENDING)
  idempotencyKey    String        @unique
  errorCode         String?
  errorDescription  String?
  metadata          Json?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  @@index([orderId])
  @@index([status])
  @@index([createdAt])
}

model PaymentWebhookEvent {
  id          String    @id @default(cuid())
  provider    String    @default("razorpay")
  eventId     String    @unique
  eventType   String
  payload     Json
  processedAt DateTime?
  createdAt   DateTime  @default(now())

  @@index([eventType])
  @@index([createdAt])
}

model PaymentAudit {
  id             String   @id @default(cuid())
  orderId        String
  order          Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  eventType      String
  message        String
  amount         Decimal? @db.Decimal(12, 2)
  previousStatus String?
  nextStatus     String?
  metadata       Json?
  createdAt      DateTime @default(now())

  @@index([orderId])
  @@index([eventType])
  @@index([createdAt])
}

model RiderPaymentCollection {
  id          String           @id @default(cuid())
  orderId     String
  order       Order            @relation(fields: [orderId], references: [id], onDelete: Cascade)
  riderId     String
  rider       Rider            @relation(fields: [riderId], references: [id], onDelete: Cascade)
  amount      Decimal          @db.Decimal(12, 2)
  method      CollectionMethod
  reference   String?
  note        String?
  collectedAt DateTime         @default(now())
  createdAt   DateTime         @default(now())

  @@index([orderId])
  @@index([riderId])
  @@index([collectedAt])
}

model OrderItem {
  id                String                     @id @default(cuid())
  orderId           String
  order             Order                      @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId         String
  product           Product                    @relation(fields: [productId], references: [id])
  quantity          Int
  priceApplied      Decimal                    @db.Decimal(12, 2)
  pricingSnapshot   Json?
  batchAllocations  OrderItemBatchAllocation[]

  @@index([orderId])
  @@index([productId])
}

model UserProductPricingRule {
  id               String                    @id @default(cuid())
  userId           String
  user             User                      @relation("BuyerPricingRules", fields: [userId], references: [id], onDelete: Cascade)
  productId        String
  product          Product                   @relation(fields: [productId], references: [id], onDelete: Cascade)
  discountType     PricingDiscountType
  discountValue    Decimal                   @db.Decimal(12, 2)
  isActive         Boolean                   @default(true)
  adminNote        String?
  createdByAdminId String?
  createdByAdmin   User?                     @relation("PricingRulesCreatedBy", fields: [createdByAdminId], references: [id], onDelete: SetNull)
  updatedByAdminId String?
  updatedByAdmin   User?                     @relation("PricingRulesUpdatedBy", fields: [updatedByAdminId], references: [id], onDelete: SetNull)
  audits           UserProductPricingAudit[]
  createdAt        DateTime                  @default(now())
  updatedAt        DateTime                  @updatedAt

  @@unique([userId, productId])
  @@index([productId])
  @@index([isActive])
  @@index([createdByAdminId])
  @@index([updatedByAdminId])
}

model UserProductPricingAudit {
  id               String                 @id @default(cuid())
  ruleId           String
  rule             UserProductPricingRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  userId           String
  productId        String
  changedByAdminId String?
  changedByAdmin   User?                  @relation("PricingAuditsChangedBy", fields: [changedByAdminId], references: [id], onDelete: SetNull)
  action           PricingRuleAuditAction
  oldValue         Json?
  newValue         Json?
  reason           String
  createdAt        DateTime               @default(now())

  @@index([ruleId])
  @@index([userId])
  @@index([productId])
  @@index([changedByAdminId])
  @@index([createdAt])
}

model Rider {
  id              String        @id @default(cuid())
  userId          String        @unique
  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  name            String
  phone           String        @unique
  status          RiderStatus   @default(IDLE)
  currentLocation Json?
  orders          Order[]
  devices         RiderDevice[]
  collections     RiderPaymentCollection[]
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([status])
  @@index([userId])
}

model RiderDevice {
  id         String   @id @default(cuid())
  riderId    String
  rider      Rider    @relation(fields: [riderId], references: [id], onDelete: Cascade)
  pushToken  String   @unique
  platform   String?
  isActive   Boolean  @default(true)
  lastSeenAt DateTime @default(now())
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([riderId])
  @@index([isActive])
}

model OtpChallenge {
  id         String    @id @default(cuid())
  phone      String
  codeHash   String
  expiresAt  DateTime
  attempts   Int       @default(0)
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([phone, expiresAt])
}
